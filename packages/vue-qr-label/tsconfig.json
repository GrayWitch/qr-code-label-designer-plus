{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "paths": {
      "@amethc/qrlayout-ui": ["../ui/src/index.ts"],
      "@amethc/qrlayout-core": ["../core/src/index.ts"],
      "@amethc/qrlayout-core/pdf": ["../core/src/pdf.ts"],
      "@amethc/qrlayout-core/*": ["../core/src/*"],
      "qrlayout-ui": ["../ui/src/index.ts"],
      "qrlayout-core": ["../core/src/index.ts"],
      "qrlayout-core/pdf": ["../core/src/pdf.ts"],
      "qrlayout-core/*": ["../core/src/*"]
    }
  },
  "include": ["src", "src/**/*.vue", "vite.config.ts"]
}
